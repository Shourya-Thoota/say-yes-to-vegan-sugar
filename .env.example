# Copy to .env (local only). Never commit .env.
# Railway: set these in the service Variables panel.

# PostgreSQL connection string (Railway injects DATABASE_URL when Postgres is attached)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vegansugar

# Auth.js v5 secret (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-me-with-a-long-random-secret

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID)
# Authorized redirect URI (Auth.js v5 default):
#   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Comma-separated allowlist of administrator emails
ADMIN_EMAILS=admin@example.org

# Public canonical URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Trust Railway proxy host headers (leave true on Railway)
AUTH_TRUST_HOST=true

# --- Sentry error monitoring (optional; app works without it) ---
# DSN = where to SEND error events (safe to expose; it only receives events).
# Get it from: Sentry -> project Settings -> Client Keys (DSN).
# Client SDK needs it at BUILD time (NEXT_PUBLIC_* is inlined), so on Railway
# set it as a build-time variable, then rebuild. Server SDK reads it at runtime.
# Leave unset for local development (monitoring stays silent).
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<orgId>.ingest.sentry.io/<projectId>
#
# Temporary admin-only synthetic test event (see README). Leave unset normally.
# SENTRY_TEST_ENABLED=true
#
# Source-map uploads are DISABLED (see next.config.mjs + README). When the
# operator sets up secure uploads, SENTRY_ORG / SENTRY_PROJECT (build-time)
# and SENTRY_AUTH_TOKEN (secret, NEVER NEXT_PUBLIC_-prefixed, never committed)
# will be needed. Do not add them yet.

# --- Stripe sponsorship (Part 3B; optional, zero-key safe mode by default) ---
# The site builds, starts, and serves /sponsor cleanly with NONE of these set.
# To turn on live checkout later, set all three on Railway + rebuild/restart:
#   ENABLE_STRIPE_SPONSORSHIP=true
#   STRIPE_SECRET_KEY=sk_live_or_test_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
# NEVER commit real keys. Never prefix secrets with NEXT_PUBLIC_.
# ENABLE_STRIPE_SPONSORSHIP=true
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
