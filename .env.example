# Copy to .env (local only). Never commit .env.
# Railway: set these in the service Variables panel.

# PostgreSQL connection string (Railway injects DATABASE_URL when Postgres is attached)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vegansugar

# Auth.js v5 secret (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-me-with-a-long-random-secret

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID)
# Authorized redirect URI (Auth.js v5 default):
#   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Comma-separated allowlist of administrator emails
ADMIN_EMAILS=admin@example.org

# Public canonical URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Trust Railway proxy host headers (leave true on Railway)
AUTH_TRUST_HOST=true
